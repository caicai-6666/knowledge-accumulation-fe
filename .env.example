# 本地开发和 preview 的代理目标；不会进入浏览器构建产物。
KNOWLEDGE_BACKEND_URL=http://127.0.0.1:15000

# 仅在 VITE_AUTH_MODE=development 时使用，必须与后端 AUTH_DEVELOPER_ACCESS_TOKEN 一致。
# 实际值写入被 Git 忽略的 .env.local，禁止以 VITE_ 开头。
KNOWLEDGE_DEVELOPER_LOGIN_CREDENTIAL=

# 登录方式与运行方式独立：production=钉钉免登，development=固定开发凭据。
# 当前示例选择钉钉登录；后端 APP_ENV 需使用相同值。
# npm run dev 自动保留 /dev 和热更新，不受该配置影响。
# npm run build / preview 使用不带 /dev 的路径，且仅允许钉钉登录。
VITE_AUTH_MODE=production

# 钉钉免登使用的企业 CorpId（公开标识），开发服务器也需要填写。
# 不要在前端配置 AppKey、AppSecret 或钉钉应用 accessToken。
VITE_DINGTALK_CORP_ID=
