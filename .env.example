# 本地开发和 preview 的代理目标；不会进入浏览器构建产物。
KNOWLEDGE_BACKEND_URL=http://127.0.0.1:24000

# 仅用于 npm run dev，必须与 knowledge-accumulation-be 的 AUTH_DEVELOPER_ACCESS_TOKEN 一致。
# 实际值写入被 Git 忽略的 .env.local，禁止以 VITE_ 开头。
KNOWLEDGE_DEVELOPER_LOGIN_CREDENTIAL=

# 默认 npm run dev 为 development，npm run build / preview 为 production。
# 在开发服务器联调生产后端时，可在 .env.development.local 设为 production。
# VITE_AUTH_MODE=production

# 生产免登使用的企业 CorpId（公开标识），与后端配置保持一致。
# 不要在前端配置 AppKey、AppSecret 或钉钉应用 accessToken。
VITE_DINGTALK_CORP_ID=
